<style>
  /* =========================================================
     TISSO VISION HEADER
     Mobile:
       CLOSED = hamburger + logo
       OPEN   = X + logo + promo text + CTA
     There is NO mobile navigation menu.
     ========================================================= */

  .tv-header-wrapper {
    position: relative;
    z-index: 20;
    width: 100%;
    background: #fff;
  }

  .tv-header {
    width: 100%;
    background: #fff;
    color: #111;
    box-shadow: 0 1px 5px rgba(0,0,0,.12);
  }

  .tv-header__desktop {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 40px;
    padding: 10px 50px;
    gap: 20px;
  }

  .tv-header__brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    color: #111;
    text-decoration: none;
    white-space: nowrap;
    object-fit: contain;
  }
  .tv-header__brand img {
    object-fit: contain;
  }

  .tv-header__brand-text {
    font-family: var(--font-heading-family);
    font-size: 15px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: .02em;
  }

  .tv-header__desktop-promo {
    justify-self: center;
    font-size: 16px;
    line-height: 13.42px;
    white-space: nowrap;
    color: #000;
  }

  .tv-header__desktop-action {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 114px;
    max-width: 207px;
    width: 100%;
    gap: 11px;
    height: 44px;
    padding: 0 12px;
    background: #FFF544;
    color: #000;
    text-decoration: none;
    font-size: 16px;
    line-height: 20.48px;
    font-weight: 400;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition: color .35s ease-in-out;
  }

  .tv-header__desktop-action::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .35s ease-in-out;
    z-index: -1;
  }

  .tv-header__desktop-action:hover {
    color: #fff;
  }

  .tv-header__desktop-action:hover::before {
    transform: scaleX(1);
  }

  .tv-header__desktop-action .stl-quickview__add-to-cart-arrow {
    position: relative;
    z-index: 1;
    transition: filter .35s ease-in-out;
  }

  .tv-header__desktop-action:hover .stl-quickview__add-to-cart-arrow {
    filter: brightness(0) invert(1);
  }

  /* Mobile trigger + content */
  .tv-mobile {
    display: none;
  }

  .tv-mobile__details {
    width: 100%;
  }

  .tv-mobile__summary {
    list-style: none;
    min-height: 65px;
    padding: 0 27px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .tv-mobile__summary::-webkit-details-marker {
    display: none;
  }

  .tv-mobile__summary::marker {
    display: none;
  }

  .tv-mobile__logo {
    font-family: var(--font-heading-family);
    font-size: 25px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: .015em;
    color: #111;
    text-decoration: none;
  }

  .tv-mobile__menu-icon {
    position: absolute;
    left: 17px;
    top: 50%;
    width: 22px;
    height: 18px;
    transform: translateY(-50%);
  }

  .tv-mobile__menu-icon::before,
  .tv-mobile__menu-icon::after,
  .tv-mobile__menu-icon span {
    content: "";
    position: absolute;
    left: 0;
    width: 22px;
    height: 2px;
    background: #111;
    transition: transform .2s ease, top .2s ease, opacity .15s ease;
  }

  .tv-mobile__menu-icon::before {
    top: 1px;
  }

  .tv-mobile__menu-icon span {
    top: 8px;
  }

  .tv-mobile__menu-icon::after {
    top: 15px;
  }

  /* When details is open: hamburger becomes X */
  .tv-mobile__details[open] .tv-mobile__menu-icon::before {
    top: 8px;
    transform: rotate(45deg);
  }

  .tv-mobile__details[open] .tv-mobile__menu-icon span {
    opacity: 0;
  }

  .tv-mobile__details[open] .tv-mobile__menu-icon::after {
    top: 8px;
    transform: rotate(-45deg);
  }

  .tv-mobile__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 42px 20px 28px;
    border-top: 1px solid #f1f1f1;
    background: #F2F2F2;
  }

  .tv-mobile__promo {
    margin: 0;
    color: #000;
    font-size: 16px;
    line-height: 13.42px;
    font-weight: 400;
  }

  .tv-mobile__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(261px, 100%);
    height: 47px;
    margin-top: 15px;
    padding: 0 20px 0 24px;
    background: #FFF544;
    color: #000;
    text-decoration: none;
    font-size: 16px;
    line-height: 20.48px;
    font-weight: 400;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition: color .35s ease-in-out;
  }

  .tv-mobile__action::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .35s ease-in-out;
    z-index: -1;
  }

  .tv-mobile__action:hover {
    color: #fff;
  }

  .tv-mobile__action:hover::before {
    transform: scaleX(1);
  }

  .tv-mobile__action .stl-quickview__add-to-cart-arrow {
    position: relative;
    z-index: 1;
    transition: filter .35s ease-in-out;
  }

  .tv-mobile__action:hover .stl-quickview__add-to-cart-arrow {
    filter: brightness(0) invert(1);
  }

  .tv-mobile__arrow {
    display: inline-block;
    width: 32px;
    height: 14px;
    position: relative;
    flex: 0 0 32px;
  }

  .tv-mobile__arrow::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 29px;
    height: 1.5px;
    background: #000;
  }

  .tv-mobile__arrow::after {
    content: "";
    position: absolute;
    right: 0;
    top: 2px;
    width: 9px;
    height: 9px;
    border-top: 1.5px solid #111;
    border-right: 1.5px solid #111;
    transform: rotate(45deg);
  }

  /* =========================================================
     Desktop / mobile breakpoint
     ========================================================= */
  @media screen and (max-width: 749px) {
    .tv-header__desktop {
      display: none;
    }

    .tv-mobile {
      display: block;
    }

    .tv-header {
      box-shadow: 0 1px 5px rgba(0,0,0,.14);
    }
  }

  @media screen and (min-width: 750px) {
    .tv-header__desktop {
      min-height: 10px;
    }
  }

  @media screen and (min-width: 990px) {
    .tv-header__desktop {
      padding-left: 50px;
      padding-right: 50px;
    }
  }

  /* Sticky Dawn compatibility */
  .section-header {
    position: sticky;
    top: 0;
    z-index: 20;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .shopify-section-header-sticky {
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .shopify-section-header-hidden {
    transform: translateY(-100%);
  }

  .shopify-section-header-sticky.animate {
    transition: transform .15s ease-out;
  }
</style>

<script>
  /*
   * TISSO VISION mobile header
   *
   * IMPORTANT:
   * There is intentionally NO mobile navigation.
   * The details element only reveals the promotional text + CTA.
   */
  document.addEventListener('DOMContentLoaded', function () {
    const details = document.querySelector('.tv-mobile__details');

    if (!details) return;

    details.addEventListener('click', function (event) {
      const link = event.target.closest('.tv-mobile__action');

      if (link) {
        return;
      }
    });
  });
</script>

{%- liquid
  assign header_tag = 'div'
  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
-%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="section-header"
>
  <div class="tv-header-wrapper">
    <header class="tv-header">

      <!-- ================= DESKTOP ================= -->
      <div class="tv-header__desktop">
        <a href="{{ routes.root_url }}" class="tv-header__brand" aria-label="{{ shop.name | escape }}">
          {% if settings.logo != blank %}
            {{
              settings.logo
              | image_url: width: 150
              | image_tag:
                class: 'tv-header__logo-image',
                widths: '120, 180, 240, 360, 400',
                loading: 'eager',
                alt: shop.name
            }}
          {% else %}
            <span class="tv-header__brand-text">TISSO VISION</span>
          {% endif %}
        </a>

        <p class="tv-header__desktop-promo">
          {{ section.settings.promo_text }}
        </p>

        <a
          href="{{ section.settings.cta_link | default: routes.root_url }}"
          class="tv-header__desktop-action"
          aria-label="{{ section.settings.cta_label }}"
        >
          {{ section.settings.cta_label }}
          <img class="stl-quickview__add-to-cart-arrow" src="https://cdn.shopify.com/s/files/1/0997/7931/3953/files/black-arrow.png?v=1787518907" alt="" width="33" height="8">
        </a>
      </div>

      <!-- ================= MOBILE ================= -->
      <!--
        CLOSED:
          hamburger + TISSO VISION

        OPEN:
          X + TISSO VISION
          Find the ideal gift for your loved ones.
          CHOOSE GIFT →

        NO navigation menu exists here.
      -->
      <div class="tv-mobile">
        <details class="tv-mobile__details">
          <summary class="tv-mobile__summary" aria-label="Open gift options">
            <span class="tv-mobile__menu-icon" aria-hidden="true"><span></span></span>

            <span class="tv-mobile__logo">
              TISSO VISION
            </span>
          </summary>

          <div class="tv-mobile__panel">
            <p class="tv-mobile__promo">
              {{ section.settings.promo_text_mobile | default: section.settings.promo_text }}
            </p>

            <a
              href="{{ section.settings.cta_link | default: routes.root_url }}"
              class="tv-mobile__action"
              aria-label="{{ section.settings.cta_label }}"
            >
              <span>{{ section.settings.cta_label }}</span>
              <img class="stl-quickview__add-to-cart-arrow" src="https://cdn.shopify.com/s/files/1/0997/7931/3953/files/black-arrow.png?v=1787518907" alt="" width="33" height="8">
            </a>
          </div>
        </details>
      </div>

    </header>
  </div>
</{{ header_tag }}>

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
      this.setHeaderHeight = this.setHeaderHeight.bind(this);
    }

    connectedCallback() {
      this.header = this.querySelector('.tv-header') || document.querySelector('.tv-header');
      this.mobileMediaQuery = window.matchMedia('(max-width: 749px)');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';

      this.headerBounds = {};
      this.setHeaderHeight();

      this.mobileMediaQuery.addEventListener('change', this.setHeaderHeight);

      if (this.headerIsAlwaysSticky) {
        this.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      if (!this.header) return;
      document.documentElement.style.setProperty(
        '--header-height',
        `${this.header.offsetHeight}px`
      );
    }

    disconnectedCallback() {
      this.mobileMediaQuery.removeEventListener('change', this.setHeaderHeight);
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      if (!this.header) return;

      const observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.classList.add('scrolled-past-header');

        if (this.preventHide) return;

        requestAnimationFrame(this.hide.bind(this));
      } else if (
        scrollTop < this.currentScrollTop &&
        scrollTop > this.headerBounds.bottom
      ) {
        this.classList.add('scrolled-past-header');

        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.classList.add(
        'shopify-section-header-hidden',
        'shopify-section-header-sticky'
      );
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.classList.add('shopify-section-header-sticky', 'animate');
      this.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.classList.remove(
        'shopify-section-header-hidden',
        'shopify-section-header-sticky',
        'animate'
      );
    }
  }

  if (!customElements.get('sticky-header')) {
    customElements.define('sticky-header', StickyHeader);
  }
{% endjavascript %}

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification',
    color_scheme: section.settings.color_scheme,
    desktop_menu_type: section.settings.menu_type_desktop
  -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "logo_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.header.settings.logo_position.options__2.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.header.settings.logo_position.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.header.settings.logo_position.options__1.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.header.settings.logo_position.options__4.label"
        }
      ],
      "default": "middle-left",
      "label": "t:sections.header.settings.logo_position.label",
      "info": "t:sections.header.settings.logo_help.content"
    },
    {
      "type": "select",
      "id": "mobile_logo_position",
      "options": [
        {
          "value": "center",
